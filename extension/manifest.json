{
  "manifest_version": 3,
  "name": "Amazanban",
  "version": "0.1.0",
  "description": "Turns your Amazon orders page into a Kanban board grouped by delivery status.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Amazanban",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/your-orders/*",
        "https://www.amazon.com/gp/your-account/order-history*",
        "https://www.amazon.com/gp/css/order-history*"
      ],
      "js": ["src/classify.js", "src/parse.js", "src/board.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/board.css"],
      "matches": ["https://www.amazon.com/*"]
    }
  ]
}
